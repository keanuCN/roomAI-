# 本地 Demo 配置。上线前替换开发凭据，并在 HTTPS 下启用安全 Cookie。
WEB_PORT=3100
API_PORT=8010
POSTGRES_PASSWORD=roomai-local-demo
MINIO_ROOT_USER=roomai
MINIO_ROOT_PASSWORD=roomai-local-storage
COOKIE_SECURE=false
# 默认免费预置演示，使用真实云端模型时再填写以下变量。
ENABLE_LIVE_GENERATION=false
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
IMAGE_MODEL=
TEXT_MODEL=
IMAGE_ESTIMATED_COST_USD=0.20
MAX_PROJECT_COST_USD=5
